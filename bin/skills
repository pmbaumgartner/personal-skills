#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = []
# ///
"""Manage local skill activation and invocation policy without copying or deleting skill sources."""

import argparse
import os
from pathlib import Path
import re
import subprocess
import sys


REPO = Path(__file__).resolve().parent.parent
SOURCES = REPO / "skills"
ACTIVE = Path.home() / ".agents" / "skills"


def exists(path):
    return os.path.lexists(path)


def source(name):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
        raise ValueError(f"Invalid skill name: {name}")
    path = SOURCES / name
    if not (path / "SKILL.md").is_file():
        raise ValueError(f"No skill source with SKILL.md: {name}")
    return path


def owned_link(path, target):
    # Compare the actual link target, not just resolved content. A link owned
    # by some other installer must not be removed even if content is shared.
    if not path.is_symlink():
        return False
    return Path(os.path.abspath(path.parent / path.readlink())) == target


def enable(name):
    target = source(name)
    path = ACTIVE / name
    if exists(path):
        if owned_link(path, target):
            print(f"{name}: already enabled")
            return
        raise ValueError(f"Refusing to overwrite unmanaged path: {path}")
    ACTIVE.mkdir(parents=True, exist_ok=True)
    path.symlink_to(target, target_is_directory=True)
    print(f"{name}: enabled")


def disable(name):
    target = source(name)
    path = ACTIVE / name
    if not exists(path):
        print(f"{name}: already disabled")
        return
    if not owned_link(path, target):
        raise ValueError(f"Refusing to remove unmanaged path: {path}")
    path.unlink()
    print(f"{name}: disabled")


def list_skills():
    for target in sorted(SOURCES.iterdir()):
        if not target.is_dir() and not target.is_symlink():
            continue
        path = ACTIVE / target.name
        if not (target / "SKILL.md").is_file():
            state = "broken source"
        elif owned_link(path, target):
            state = "enabled"
        elif exists(path):
            state = "unmanaged conflict"
        else:
            state = "disabled"
        print(f"{target.name:42} {state}")
    if ACTIVE.is_dir():
        for path in sorted(ACTIVE.iterdir()):
            if path.is_symlink() and not path.exists():
                print(f"{path.name:42} broken active link -> {path.readlink()}")


CLAUDE_KEY = "disable-model-invocation"
CODEX_KEY = "allow_implicit_invocation"


def read_flag(lines, key):
    for line in lines:
        match = re.fullmatch(rf"\s*{key}:\s*(true|false)\s*", line)
        if match:
            return match.group(1) == "true"
    return None


def set_flag(lines, key, value, indent, insert_at):
    """Replace key's line, or insert it at insert_at if absent."""
    line = f"{indent}{key}: {'true' if value else 'false'}"
    for i, existing in enumerate(lines):
        if re.fullmatch(rf"\s*{key}:.*", existing):
            lines[i] = line
            return
    lines.insert(insert_at, line)


def newline(text):
    return "\n" if text.endswith("\n") else ""


def frontmatter_end(lines):
    if not lines or lines[0] != "---" or "---" not in lines[1:]:
        raise ValueError("SKILL.md has no frontmatter")
    return lines.index("---", 1)


def invocation(name, mode=None):
    target = source(name)
    skill = target / "SKILL.md"
    codex = target / "agents" / "openai.yaml"
    skill_text = skill.read_text()
    skill_lines = skill_text.splitlines()
    end = frontmatter_end(skill_lines)
    codex_text = codex.read_text() if codex.is_file() else "\n"
    codex_lines = codex_text.splitlines()
    if mode:
        manual = mode == "manual"
        frontmatter = skill_lines[:end]
        set_flag(frontmatter, CLAUDE_KEY, manual, "", end)
        skill.write_text("\n".join(frontmatter + skill_lines[end:]) + newline(skill_text))
        if "policy:" not in codex_lines:
            codex_lines.append("policy:")
        policy = codex_lines.index("policy:") + 1
        set_flag(codex_lines, CODEX_KEY, not manual, "  ", policy)
        codex.parent.mkdir(exist_ok=True)
        codex.write_text("\n".join(codex_lines) + newline(codex_text))
        print(f"{name}: {mode}")
        return
    # Both agents allow implicit invocation when their setting is absent.
    claude = "manual" if read_flag(skill_lines[:end], CLAUDE_KEY) else "auto"
    implicit = read_flag(codex_lines, CODEX_KEY)
    codex_mode = "manual" if implicit is False else "auto"
    if claude == codex_mode:
        print(f"{name}: {claude}")
    else:
        print(f"{name}: mismatched (Claude Code/Pi {claude}, Codex {codex_mode})")


def git(*args):
    return subprocess.run(
        ["git", "-C", str(REPO), *args],
        check=True, text=True, capture_output=True,
    ).stdout.strip()


def update():
    if git("status", "--porcelain", "--untracked-files=all"):
        raise ValueError("Working tree is dirty; commit or stash changes before updating.")
    if not git("remote"):
        raise ValueError("No remote configured; add your personal-skills Git remote first.")
    # With no explicit remote or branch, Git requires a configured upstream.
    subprocess.run(["git", "-C", str(REPO), "pull", "--ff-only"], check=True)
    external = [p.name for p in SOURCES.iterdir() if p.is_symlink()]
    if external:
        print("Independent sources not updated: " + ", ".join(sorted(external)))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="Show available skills and local activation")
    for command in ("enable", "disable"):
        commands.add_parser(command).add_argument("name")
    policy = commands.add_parser(
        "invocation", help="Show or set whether agents may invoke a skill automatically"
    )
    policy.add_argument("name")
    policy.add_argument("mode", nargs="?", choices=("manual", "auto"))
    commands.add_parser("update", help="Fast-forward the clean source checkout")
    args = parser.parse_args()
    try:
        if args.command == "list":
            list_skills()
        elif args.command == "enable":
            enable(args.name)
        elif args.command == "disable":
            disable(args.name)
        elif args.command == "invocation":
            invocation(args.name, args.mode)
        else:
            update()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"skills: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
